#!/usr/bin/env bash

if [ -z ${SHELLBITS_LIB_LOGGING+x} ]; then
    source $SHELLBITS_LIB/logging.sh
fi

usage() {
cat <<END
Usage: $0 INFO_TYPE [OPTIONS] [DIR]

Quickview a location's last use and .gitignored folder structure.

DIR defaults to the working directory if not specified. Otherwise,
each INFO_TYPE passes through any OPTIONS to the wrapped command:

    help, --help
        show this message. (Does not take further options)

    o,old
        List the location's items with oldest items last.

        Wraps: lu -o old "\$@"

    n,new
        List the location's items with newest items last.

        Wraps: lu -o new "\$@"

    t,tree
        Translate .gitignore for buggy old tree versions (v2.1.0, etc)

        Wraps: twee "\$@"

    m,mon
       Run twee against a target and refresh the view each time the FS changes.

    w,r,rstrip
        Remove trailing whitespace before line endings.

        Wraps: rstrip "$@"

END
}


what=""
case "$#" in
    0) what="help" ;;
    *) what="$1"; shift ;;
esac

case "$what" in
    t|tree)
        twee "$@"
        ;;
    r|w|rstrip)
        rstrip "$@"
        ;;
    o|n|old|new)
        lu -o "$what" "$@"
        ;;
    m|mon)
        twee-mon "$@"
        ;;
    --help|help|h)
        if [ "$#" -gt 0 ]; then
            usage 1>&2
            error "$what does not take additional arguments."
            exit 1
        else
            usage
        fi
        ;;
    *)
        error "Unknown value: '$what'"
        exit 1
        ;;
esac

