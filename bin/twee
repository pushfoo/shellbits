#!/usr/bin/env bash

usage() {
local app="$(basename "$0")"
cat << END
Usage: $app [OPTIONS] [directory]

Wraps tree by translating known-buggy .gitignore rules.

When the directory is not provided, it will default to the
current working directory. The directory will be passed as
an argument to tree after the following:

1. The --gitignore flag
2. Any rules translated from the .gitignore
3. Any passed OPTIONS

OPTIONS:

    --help
        Show this info.

    -D
        Show dates to the left of directories and folders.

    --dirsfirst
        Sort with directories first.

    [ See man tree or tree --help for more options ]

Users on distros with later tree versions might not need
this script. It helps users whose tree versions does not
properly implement .gitignore. Debian bookworm is a good
example since it shipped the knownb-buggy tree v2.1.0 at
the time of writing.

END
}

# ifndef-like imports
if [ -z ${SHELLBITS_LIB_LOGGING+x} ]; then
    source "$SHELLBITS_LIB/logging.sh"
fi
if [ -z ${SHELLBITS_LIB_PATHS+x} ]; then
    source "$SHELLBITS_LIB/paths.sh"
fi


convert_rule_to_flag() {
    # Echo a translated `tree` flag if passed a known-bad rule or `""`.
    #
    # | Buggy Format | Equivalent Flag | PCRE                      |
    # |--------------|-----------------|---------------------------|
    # | `RULE/`      | `-I RULE`       | `^[^#].*\/(?=(\s*#.*)?$)` |

    if [[ "$1" =~ ^[^#].*\/(\s*#.*)?$ ]]; then
        echo "-I $(echo "$1" | sed -r 's/(^[^#].*)(\/)(\s+#.)?$/\1/')"
    else
        echo ""
    fi
}


build_tree_workaround() {
    # Convert known-broken rules in a `.gitignore` file to `tree` flags.

    # String processing for a whole file is slow so we just echo it
    while read -r rule; do
        local flag="$(convert_rule_to_flag "$rule")"
        if [ ! -z "$flag" ]; then
            echo "$flag"
        fi
    done < "$1"
}


run_twee() {
    local tree_args="$@"
    local raw_path=""
    # BUG: not getting the array args correctly?
    if [ "$#" -gt 0 ] && [[ "$arg" =~ ^- ]]; then
        local last_index="$(($#-1))";
        raw_path="${@[last_index]}"
    else
        raw_path="$(pwd)"
        tree_args+=("$raw_path")
    fi
    raw_path="$(get_valid_path_or_cwd "$raw_path")"

    local exitval=0
    local path="$(get_valid_path_or_cwd "$raw_path")"
    local workaround_ignore_flags=""

    if [ -z "$path" ]; then
        error "Cannot resolve path for '$@'"
        exitval=1
    else
        debug "path=$path"
        local gitignore="$(get_file_in_path "$path" .gitignore)"
        if [ -z "$gitignore" ]; then
            info "No .gitignore found: '$path'"
        else
            info "Found .gitignore: '$gitignore'"
            workaround_ignore_flags="$(build_tree_workaround "$gitignore")"
        fi
    fi
    debug "base args: $tree_args"
    debug "path     : $path"
    tree --gitignore $workaround_ignore_flags $tree_args
    exit "$exitval"
}

debug "\$\@: \"$@\""

if [ "$#" -eq 1 ] && [ "$1" == "--help" ]; then
    usage
    exit 0
else
    run_twee "$@"
fi

