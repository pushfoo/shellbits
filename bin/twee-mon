#!/usr/bin/env bash

APP_NAME="$0"
usage() {
cat << END
usage: $APP_NAME DIR

Display a twee view which refreshes on changes to a DIR.

Exit via Ctrl-C.

WARNING: This is a simple implementation, not a complete one!

Drawbacks currently include:

* Exit is only via Ctrl-C
* No Mac support since inotify-tools is Linux-specific
* Configuration is limited to overriding twee by either:
  - Aliasing twee to a custom script
  - Setting SHELLBITS_CUSTOM_TWEE environment variable
* No modification filtering beyond .git folders in DIR)
  - Large projects / git checkouts are not accounted for
  - Auto-rebuild scripts may cause unexpected behavior

Otherwise, $APP_NAME is a passable and editor-agnostic to:

* tmux
* screen
* similar tools

END
}

if [ -z ${SHELLBITS_LIB_LOGGING+x} ]; then
    source "$SHELLBITS_LIB/logging.sh"
fi
if [ -z ${SHELLBITS_LIB_PATHS+x} ]; then
    source "$SHELLBITS_LIB/paths.sh"
fi

CUSTOM_TWEE
REQUIRES="inotifywait"
MISSING="$(check_missing "$REQUIRES")"
if [ ! -z "$MISSING" ]; then
    error "Missing required components: $MISSING"
    exit 1
fi

TARGET="$1"
if [ "$TARGET" == "--help" ]; then
    usage
    exit 0
fi


TWEE_CMD=""
if [ -z ${SHELLBITS_CUSTOM_TWEE+x } ]; then
    TWEE_CMD="twee --noreport --dirsfirst"
else
    TWEE_CMD="$SHELLBITS_CUSTOM_TWEE" 
fi

render_tree() {
    # Draw the tree in the pane at top left

    tput cup 0 0
    tput clear
    $TWEE_CMD "$TARGET"
    tput bel
}

clear
render_tree

listen_fs() {
    # Echoes the dir and path of a file each time something changes
    #
    # TODO: Double-check format + offer a non-inotify backing loop

    # Important: the .git exclude prevents noise from git status + git fetch!
    inotifywait\
        -q -e modify,move,create,delete\
        -m -r "$TARGET" --exclude ".git"\
        --format '%w %f'
}

# Enter an infinite loop which responds to filesystem changes
listen_fs | while read -r dir name; do
    render_tree
done

