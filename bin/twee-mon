#!/usr/bin/env bash

usage() {
cat << END
usage: twee-mon DIR

Display a twee view which refreshes on changes to a DIR.

WARNING: This is a simple implementation, not a complete one!

It is best used for **small** projects on Linux since it:

1. does not filter change events according to .gitignore rules
2. may not work on Mac due to the inotify-tools dependency

Otherwise, it's passable as an editor-agnostic companion for:

* tmux
* screen
* similar tools

END
}

if [ -z ${SHELLBITS_LIB_LOGGING+x} ]; then
    source "$SHELLBITS_LIB/logging.sh"
fi
if [ -z ${SHELLBITS_LIB_PATHS+x} ]; then
    source "$SHELLBITS_LIB/paths.sh"
fi


REQUIRES="inotifywait"
MISSING="$(check_missing "$REQUIRES")"
if [ ! -z "$MISSING" ]; then
    error "Missing required components: $MISSING"
    exit 1
fi

TARGET="$1"
if [ "$TARGET" == "--help" ]; then
    usage
    exit 0
fi

do_twee() {
    tput cup 0 0
    tput clear
    twee --noreport --dirsfirst "$TARGET"
    tput bel
}

clear
do_twee

listen_fs() {
    # Echoes the dir and path of a file each time something changes
    #
    # TODO: Double-check format + offer a non-inotify backing loop
    inotifywait\
        -q -e modify,move,create,delete\
        -m -r "$TARGET"\
        --format '%w %f'
}

# Enter an infinite loop which responds to filesystem changes
listen_fs | while read -r dir name; do
    do_twee
done

