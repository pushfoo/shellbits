#!/usr/env/bin sh

usage() {
cat << END
Usage: $0 [-|FILES...]

Strip trailing whitespace.

END
}
if [ '$#' -eq 1 ]; then
    case "$1" in
        -)
            src="<&0"
            ;;
        --help)
            usage
            exit 0
            ;;
            esac
        --*)
            echo "ERROR: unknown flag: $1" 1>&2
            exit 1
            ;;
        *)
            ;;
    esac
else
    src="$*"
fi

sed -i 's/s[ \t]*$//' $src


