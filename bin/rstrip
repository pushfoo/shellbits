#!/usr/bin/env bash

if [ -z ${SHELLBITS_LIB_LOGGING+x} ]; then
    source "$SHELLBITS_LIB/logging.sh"
fi

usage() {
cat << END
Usage: $0 [-|FILES...]

Strip trailing whitespace.

END
}

src="$@"
if [ "$#" -eq 1 ]; then
    if [ "$1" == "--help" ]; then
        usage
    elif [ "$1" == "-" ]; then
        sed -i 's/s[ \t]*$//' <&0
    fi
else
    sed -i 's/s[ \t]*$//' "$@"
fi


